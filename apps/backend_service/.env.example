# ============================================================
# GramCare AI — Backend Service Environment Variables (TEMPLATE)
# Copy to .env and fill in real values. .env itself is gitignored;
# this .example file is the only one meant to be committed.
# ============================================================

# DATABASE — PostgreSQL is REQUIRED (Neon in production). There is no SQLite
# fallback: if this is unset or unreachable the backend fails to start. SQLite
# is used only by the automated test suite. For Neon, copy the connection
# string from the project dashboard and keep the ?sslmode=require suffix.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# JWT Authentication — generate a real random secret for any non-local use,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# MUST match the value backend/node_api reads (see docker-compose.yml).
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI Providers ------------------------------------------------------------
# All optional. Any provider left blank is simply skipped by AIManager —
# the application always has MockProvider as a final, non-failing fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- AIManager configuration (apps/backend_service/ai/) ---------------------
AI_PROVIDER_PRIORITY=gemini,openai,groq,anthropic,mock
# AI_PROVIDER_PRIORITY_TRIAGE=gemini,openai,groq,anthropic,mock
# AI_PROVIDER_PRIORITY_OCR=gemini,openai,mock
# AI_PROVIDER_PRIORITY_DOCTOR_SUMMARY=gemini,openai,groq,anthropic,mock
AI_HEALTH_CACHE_SECONDS=180
AI_REQUEST_TIMEOUT_SECONDS=20

# Razorpay Payment Gateway (leave blank for mock-mode payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Dashboard's Webhooks section (separate
# from the API keys above) — required for POST /api/v1/payments/webhook to
# accept anything; without it the endpoint always returns 503.
RAZORPAY_WEBHOOK_SECRET=

# CORS (comma-separated origins allowed to call this backend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:80

# Node.js Signaling Server URL (for backend-to-signaling communication)
NODE_SIGNALING_URL=http://localhost:4000

# Emergency SOS escalation window (seconds)
SOS_ESCALATION_AFTER_SECONDS=180

# --- Cloudinary (file storage) -----------------------------------------------
# Optional: family profile photos, symptom/prescription/invoice scan images,
# lab report attachments, and batch recall notices. Left blank, uploads are
# simply skipped (core/cloudinary_service.py degrades gracefully, same
# convention as every other optional external credential in this file).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
