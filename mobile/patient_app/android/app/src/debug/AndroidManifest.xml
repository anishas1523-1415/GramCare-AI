<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY. This file lives in src/debug/, so it is merged
         into debug APKs and never into a release one.

         Android blocks cleartext HTTP from API 28 onwards, loopback included.
         The on-device integration test points the app at a backend running on
         the developer's machine, reached through `adb reverse tcp:8010`, so
         the handset sees it as http://localhost:8010 — and without this the
         request never leaves the device.

         A release build is unaffected and still refuses cleartext. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
