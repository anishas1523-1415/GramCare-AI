node_modules/
__pycache__/
*.pyc
.env
.env.*
!.env.example
# .env.production files contain ONLY public client-bundle values
# (NEXT_PUBLIC_*/VITE_*) and must ship with the repo so Vercel/CI builds
# get production URLs without dashboard configuration.
!.env.production
.venv
venv/
dist/
build/
.DS_Store
# Previously only gramcare.db and *.sqlite3 were excluded. database.py's
# fallback path writes to gramcare_local.db specifically (see
# ALLOW_SQLITE_FALLBACK in apps/backend_service/database.py) — that file,
# and any other stray local DB file, was NOT covered, risking real local
# patient/appointment data ending up committed.
*.db
*.sqlite3
.svelte-kit/
*firebase-adminsdk*.json
firebase-service-account.json
.pytest_cache/
.next/
coverage/
.vscode/
.idea/
*.log
npm-debug.log*
# Claude Code local tool config (dev-server launch config, local
# permission grants, scheduler lock) — machine-local, not project source.
.claude/
# Playwright's per-run screenshots/traces from apps/web_portal/e2e — output,
# not source; regenerated by every `npm run test:e2e`.
test-results/
# Kotlin/Gradle incremental-compiler session lock — changes every Android
# build, was previously getting committed by accident.
*.salive
package-lock.json.old
apk-builds/
# The root npm-workspaces lockfile (web_portal/react_dashboard/lab_portal +
# packages/api-client) is generated on Windows here, and npm only records
# the platform-specific optional native binaries (lightningcss, rolldown)
# it resolves on the generating machine — a Windows-built lockfile is
# missing the Linux entries these packages need, which broke both GitHub
# Actions CI and every Vercel deploy since the npm-workspaces migration
# (11 straight failed production deploys). Not committing it forces a
# fresh `npm install` on whichever platform actually builds, resolving
# the correct binary every time instead of trusting a stale, wrong-platform
# lockfile.
package-lock.json
